# =========================================================================
# HealthyStudy Intranet Microservice — Contabo Production (.env for PM2)
# Copy this file to `.env` on the server and fill in production secrets.
# =========================================================================

PORT=3004
NODE_ENV=production
TZ=Asia/Tashkent
SWAGGER_ENABLED=false
# Set PUBLIC_BASE_PATH=/intranet-service if Swagger UI is temporarily enabled behind Nginx
PUBLIC_BASE_PATH=

# PostgreSQL (Local host Postgres on Contabo VPS)
# Prefer DB_* variables instead of DATABASE_URL unless connecting to managed SSL Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthystudy_intranet_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DB_SYNCHRONIZE=false
DB_AUTO_CREATE=true
DB_RUN_MIGRATIONS=true
DB_SSL=false

# Shared Secrets (MUST match Main Backend :3000 and Community Service :3002)
JWT_SECRET=CHANGE_ME_SAME_AS_MAIN_BACKEND_JWT_SECRET
INTERNAL_SERVICE_SECRET=CHANGE_ME_SAME_AS_MAIN_BACKEND_INTERNAL_SECRET

# Optional External Project REST API Keys (format: key1:tenant1,key2:tenant2)
EXTERNAL_API_KEYS=

# ImageKit Media Upload Auth (MUST match active CourseBazaar ImageKit account)
IMAGEKIT_PUBLIC_KEY=public_vMW84hxdw+MYuWlwYDn+kmQ44as=
IMAGEKIT_PRIVATE_KEY=CHANGE_ME_REAL_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/me8mkyccw

# Lost & Found Automation & Webhooks
LOST_FOUND_ARCHIVE_DAYS=45
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3002
WEBHOOK_URL=
WEBHOOK_SECRET=

# Main Backend & Frontend URLs
MAIN_BACKEND_URL=http://127.0.0.1:3000
MAIN_URL=https://coursebazaar.uz
CORS_ORIGINS=https://coursebazaar.uz,https://www.coursebazaar.uz,https://admin.coursebazaar.uz,https://lms.coursebazaar.uz,https://register.coursebazaar.uz
